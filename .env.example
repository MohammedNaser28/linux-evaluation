# Supabase project
# From your Supabase dashboard: Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
# Server-side only. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Roster of expected student IDs (comma separated, no spaces).
# Used by the admin page to show who hasn't connected/submitted yet.
EXPECTED_STUDENTS=2021170001,2021170002,2021170003

# Optional: fixed number of levels. Defaults to the distinct levels found.
TOTAL_LEVELS=10

# Password that protects /admin. The admin API rejects requests without
# this as a bearer token. Leave empty to disable the admin API entirely.
ADMIN_TOKEN=change-me